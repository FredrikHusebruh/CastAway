# Hostinger (LiteSpeed/Apache) settings for the static CastAway site.

AddType application/geo+json .geojson

<IfModule mod_headers.c>
  # The forecast files and the page keep their names between daily builds: browsers must always revalidate.
  <FilesMatch "\.(json|geojson|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Built JS/CSS in assets/ have content hashes in their names, so they can be cached for a year.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/geo+json image/svg+xml
</IfModule>
